# Server-only Supabase transaction-pooler connection; never use a VITE_ prefix.
DATABASE_URL=
DATABASE_CA=
SYSTEMA_ADMIN_EMAIL=
# Leave DATABASE_URL empty for a local SQLite workspace.
SYSTEMA_DB=./data/systema.sqlite
# Server-only private document storage. Never use a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local SQLite mode stores files under this ignored directory.
SYSTEMA_DOCUMENTS_DIR=./data/documents
